# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Test & Caches
.cache/
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv/
env/
venv/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# FlightML Specific: Data files & proprietary Eurocontrol archives (CRITICAL - DO NOT COMMIT)
/data/*
!/data/airports.csv
!/data/runways.csv
!/data/navaids.csv
!/data/airport-frequencies.csv
!/data/fuel/
!/data/fuel/weekly_jet_fuel_prices.csv

*.parquet
*.tsv
*.zip
*.tar
*.gz
*.bz2
*.7z
*.pkl
*.pickle
*.duckdb
*.duckdb.wal

# Ignore all other CSV files except approved open aeronautical catalogs, OpenAP & EIA benchmarks
*.csv
!/data/airports.csv
!/data/runways.csv
!/data/navaids.csv
!/data/airport-frequencies.csv
!/data/fuel/weekly_jet_fuel_prices.csv
!/flightml/data/**/*.csv

# Generated HTML visualization maps from CLI runs
*.html
